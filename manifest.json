{
  "manifest_version": 3,
  "name": "ScamShield",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "python_test@exemplu.com"
    }
  },
  "permissions": [
    "nativeMessaging", 
    "activeTab", 
    "scripting", 
    "storage", 
    "tabs"],
  "host_permissions": [
    "https://scamshield-docker.onrender.com/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://web.whatsapp.com/*", 
        "*://*.messenger.com/*", 
        "*://mail.google.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["security.js", "popup.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "action": { 
    "default_popup": "popup.html", 
    "default_icon": "icon.svg" 
  }
}